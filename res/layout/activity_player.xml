<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 锁定后挡住所有触摸（解锁按钮除外），防误触 -->
    <View
        android:id="@+id/touch_blocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone" />

    <!-- 双击快进/快退的提示 -->
    <TextView
        android:id="@+id/skip_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- v11.0：左上标题 -->
    <TextView
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:maxWidth="240dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:background="#99000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- v11.0：右侧竖排圆钮 -->
    <LinearLayout
        android:id="@+id/side_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/play_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pause"
            android:contentDescription="@string/player_pause" />

        <Button
            android:id="@+id/speed_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/circle_bg"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="1.0x"
            android:contentDescription="@string/player_speed" />

        <ImageButton
            android:id="@+id/lock_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lock"
            android:contentDescription="@string/player_lock" />

        <ImageButton
            android:id="@+id/pip_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_pip"
            android:contentDescription="@string/player_pip" />

        <ImageButton
            android:id="@+id/rotate_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_rotate"
            android:contentDescription="@string/rotate" />

        <ImageButton
            android:id="@+id/download_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_file_download"
            android:contentDescription="@string/download_video" />

    </LinearLayout>

    <!-- 锁定状态下唯一的解锁入口 -->
    <ImageButton
        android:id="@+id/unlock_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/circle_bg"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock"
        android:contentDescription="@string/player_unlock"
        android:visibility="gone" />

</FrameLayout>
