<?xml version="1.0" encoding="utf-8"?>
<!-- v8: Edge 式双栏布局。
     顶部地址行：[engine chip][地址 EditText 撑满加宽][刷新/停止二合一按钮]。
     底部导航行：[后退][前进][主页][新标签 +][标签页数][⋯菜单]，6 图标均分。
     两行位置（地址行顶部/底部）由代码按偏好重排，导航行始终在最下。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- 地址行（默认顶部；设置里可换到底部，叠在导航行上面） -->
    <LinearLayout
        android:id="@+id/address_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1F1F1F"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- v6：搜索引擎快捷切换 chip（点一下弹菜单换引擎） -->
        <TextView
            android:id="@+id/engine_chip"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Bing"
            android:textColor="#4DD0E1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- v5：地址栏直输 EditText。平时显示网址，点一下全选+弹键盘，回车跳转 -->
        <EditText
            android:id="@+id/address_pill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/pill_bg"
            android:gravity="center_vertical"
            android:hint="输入网址或搜索关键词"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textCursorDrawable="@null"
            android:textSize="14sp" />

        <!-- v8：刷新/停止二合一按钮（加载中显示 ✕ 停止，加载完显示刷新） -->
        <ImageView
            android:id="@+id/refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="刷新"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_refresh" />

    </LinearLayout>

    <!-- WebView 区（悬浮进度条 + 状态条） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:background="#CC1F1F1F"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 页内查找浮动条（默认隐藏） -->
    <LinearLayout
        android:id="@+id/find_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F1F1F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/find_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="在页面上查找"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/find_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="上一个"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_up" />

        <ImageView
            android:id="@+id/find_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="下一个"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_down" />

        <ImageView
            android:id="@+id/find_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="关闭查找"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_close" />

    </LinearLayout>

    <!-- v8：底部导航行（6 图标均分，只在底部出现） -->
    <LinearLayout
        android:id="@+id/nav_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1F1F1F"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="后退"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/forward_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="前进"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_forward" />

        <ImageView
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="主页"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/newtab_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="新标签页"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_add" />

        <FrameLayout
            android:id="@+id/tabs_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="标签页"
                android:src="@drawable/ic_tab" />

            <TextView
                android:id="@+id/tabs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </FrameLayout>

        <ImageView
            android:id="@+id/menu_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="菜单"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_more_vert" />

    </LinearLayout>

</LinearLayout>
